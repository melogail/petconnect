# --------------------------------------------------------------------------
# Testing environment
# --------------------------------------------------------------------------
# This file exists so `--env=testing` is actually safe. Without it, Laravel
# falls back to plain `.env` with only APP_ENV overridden, and `.env` is
# DB_CONNECTION=mysql / DB_DATABASE=petconnect — the real development
# database. `php artisan migrate:fresh --env=testing` therefore used to drop
# every table in it. See .ai/rules/migrations.md, "--env=testing is NOT a
# safety flag here".
#
# Every value below is inert: no real credential, no real database, no real
# mail/S3/queue/Redis endpoint. Nothing here may be copied out of `.env`.
#
# Under PHPUnit this file AND phpunit.xml's <php><env> entries are both in
# play, so the keys phpunit.xml sets are mirrored here verbatim. If you change
# one, change the other in the same commit or the suite and `--env=testing`
# will quietly disagree.

APP_NAME=PetConnect
APP_ENV=testing
# Throwaway key generated with `php artisan key:generate --show` for this file
# alone. It encrypts nothing that outlives a test run.
APP_KEY=base64:qkHfe04+bP1mAcyR7N91HFC/5EZjSbpLral37zZF3pY=
APP_DEBUG=true
APP_URL=https://petconnect.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Mirrors phpunit.xml.
APP_MAINTENANCE_DRIVER=file

# Mirrors phpunit.xml: 4 rounds, not 12. Hashing dominates auth test time.
BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --------------------------------------------------------------------------
# Database — the hazard fix
# --------------------------------------------------------------------------
# Mirrors phpunit.xml. `:memory:` is what keeps `migrate:fresh --env=testing`
# off MySQL. DB_HOST/DB_PORT/DB_USERNAME/DB_PASSWORD are deliberately absent:
# there is nothing here for a mysql connection to resolve against even if a
# command asks for one. DB_URL is present-but-empty, as in phpunit.xml, so a
# stray DB_URL cannot smuggle a real DSN in.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
DB_URL=

# Mirrors phpunit.xml. Array/sync drivers only — nothing touches a real
# session table, cache store, queue table or broadcaster.
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=array

# Mirrors phpunit.xml. Mail is collected in memory; no host, port or
# credentials are defined, so a misconfiguration fails loudly rather than
# sending.
MAIL_MAILER=array
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS_*, REDIS_*, MEMCACHED_* and NOVA_LICENSE_KEY are intentionally omitted.
# No driver selected above reads them, and an absent key cannot leak.

VITE_APP_NAME="${APP_NAME}"

# Nova reads these at boot; config defaults happen to match, but they are
# pinned so an admin-guard test never depends on a default drifting.
NOVA_GUARD=admin
NOVA_PASSWORDS=admins
NOVA_APP_NAME="${APP_NAME}"
NOVA_CURRENCY=EGP

# Mirrors phpunit.xml. None of these packages is installed today
# (`composer show --direct`); the entries exist so the two files agree and
# stay agreeing if one ever is.
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
