APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# This file is the only place the project defaults to SQLite. Local
# development runs MySQL 8 (`DB_CONNECTION=mysql` in .env) and the test suite
# runs SQLite in memory (phpunit.xml), so index and schema decisions must hold
# on InnoDB, not just on SQLite. Uncomment the block below when you point a
# checkout at MySQL.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Session and cache are a per-request tax, so pick the driver deliberately.
# `database` costs 2-3 queries on EVERY request (a `sessions` read, a write,
# and any cache read) before the page does any work of its own: the same home
# feed request measured 9 queries with SESSION_DRIVER=array and 12 for a guest
# / 11 authenticated with SESSION_DRIVER=database. That is more than several of
# the eager-load fixes in this codebase were worth, and it applies everywhere.
# In production set SESSION_DRIVER=redis and CACHE_STORE=redis — Redis is
# already configured below and currently unused. Keep `database` locally only
# if you want one less service to run.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# No queue worker is deployed anywhere in this project — there is no
# `queue:work` in composer.json's dev script, no supervisor config and no
# Horizon. Anything dispatched onto this connection is written to `jobs` and
# never runs. Either run a worker and document it in the deploy, or keep work
# synchronous (see User::registerMediaConversions()).
QUEUE_CONNECTION=database

# See the SESSION_DRIVER note above: use redis in production.
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

NOVA_LICENSE_KEY=
NOVA_GUARD=admin
NOVA_PASSWORDS=admins

# --------------------------------------------------------------------------
# Session cookie security
# --------------------------------------------------------------------------
# config/session.php reads this with no default, so leaving it unset resolves
# to null and the session cookie is sent WITHOUT the `Secure` attribute — over
# plain HTTP as readily as over TLS. Set it to true on every deployment served
# over HTTPS. It is false here because the local server is http://localhost.
SESSION_SECURE_COOKIE=false

# --------------------------------------------------------------------------
# Password confirmation window
# --------------------------------------------------------------------------
# Seconds a password confirmation stays valid. One hour, deliberately shorter
# than Laravel's three: confirming unlocks settings/security, the two-factor
# recovery codes, two-factor.disable and passkey registration, and a passkey
# registered inside the window outlives a later password change.
AUTH_PASSWORD_TIMEOUT=3600

# --------------------------------------------------------------------------
# Passkeys
# --------------------------------------------------------------------------
# Secret used to derive the opaque WebAuthn user handle. It falls back to
# APP_KEY when unset, which works but ties every registered passkey to the
# application key: rotating APP_KEY would orphan them. Set it to its own value
# (`php artisan key:generate --show`) before the first passkey is registered,
# and treat it as permanent from then on.
PASSKEYS_USER_HANDLE_SECRET=

# --------------------------------------------------------------------------
# Media
# --------------------------------------------------------------------------
# The filesystem disk every uploaded avatar and pet photo is written to, from
# config/media-library.php. `public` keeps them under storage/app/public and
# needs `php artisan storage:link`. Point it at s3 in production; moving it
# after files exist means moving the files too, because
# App\MediaLibrary\MediaPathGenerator builds stored paths from the media row.
MEDIA_DISK=public

# Outside production the media library's own lazy loading is turned OFF so
# Model::preventLazyLoading() can see an N+1 through getFirstMediaUrl(). Leave
# it alone unless you are debugging that guardrail; see .ai/rules/config.md.
# FORCE_MEDIA_LIBRARY_LAZY_LOADING=false

# --------------------------------------------------------------------------
# Google Maps (client side)
# --------------------------------------------------------------------------
# Read by the bundle at build time (resources/js/lib/googleMaps.ts), not by
# PHP, so it is baked into the published JavaScript and is public by design.
# That is only safe because the key is restricted: in the Google Cloud console
# set an HTTP referrer restriction to this deployment's domains and an API
# restriction to Maps JavaScript + Geocoding. An unrestricted key in a bundle
# is a billable account anyone can spend. Unset, maps degrade to the
# coordinate readout and no request is made.
VITE_GOOGLE_MAPS_API_KEY=
