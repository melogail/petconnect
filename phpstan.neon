includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    parallel:
        # PHPStan's parallel worker pool deadlocks on this toolchain: the run
        # never terminates (0% CPU, no progress), so `composer ci:check` and
        # `composer test` hang instead of failing. `maximumNumberOfProcesses: 1`
        # does NOT help - PHPStan still forks one worker and uses the socket
        # pool. 0 yields a zero-process schedule, which makes PHPStan analyse
        # in-process. Full run is ~3s today; revisit if analysis gets slow.
        maximumNumberOfProcesses: 0

    ignoreErrors:
        # Media Library Pro is a separate paid package that is not installed,
        # but config/media-library.php ships a reference to its TemporaryUpload
        # model. Nothing to fix here short of buying the package.
        -
            message: '#^Class Spatie\\MediaLibraryPro\\Models\\TemporaryUpload not found\.$#'
            path: config/media-library.php

        # Laravel's where() accepts a queryable on its $column side at runtime
        # but declares array|Closure|Expression|string. The correlated subquery
        # in CountUnreadConversations needs the Eloquent builder there to keep
        # the SoftDeletes scope; the class docblock records every alternative
        # that was tried. One occurrence, pinned by count.
        -
            message: '#^Parameter \#1 \$column of method Illuminate\\Database\\Eloquent\\Builder<App\\Models\\Conversation>\:\:where\(\) expects .*, Illuminate\\Database\\Eloquent\\Builder<App\\Models\\Message> given\.$#'
            path: app/Actions/Messaging/CountUnreadConversations.php
            count: 1
